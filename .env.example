# Never commit real credentials.
DATABASE_URL="postgresql://fuel_tracker:change-me@localhost:5432/fuel_tracker?schema=public"
# Optional. CSV source must be public, authorised for automated retrieval, and contain station fields.
PUBLIC_PRICE_CSV_URL=""
# Run this job from a trusted scheduler; protects the manually-triggered collector endpoint.
COLLECTOR_SECRET="replace-with-long-random-value"

# Vercel cron authentication. Required in production.
CRON_SECRET="replace-with-a-different-long-random-value"
# HTTP Basic Auth for /admin and /api/admin in production.
ADMIN_USER="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Optional routing provider. Defaults to the public OSRM endpoint.
ROUTING_URL="https://router.project-osrm.org"
